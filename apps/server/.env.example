# Server application configuration. Replace every placeholder before production use.
DATABASE_URL=postgresql://postgres:password@localhost:5432/framerfordevs
DATABASE_POOL_MAX=10
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
APPLICATION_LOG_LEVEL=info

# Use memory only for development or a deliberately single-process deployment.
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_TIMEOUT_MS=100
RATE_LIMIT_FINGERPRINT_SECRET=replace-with-a-separate-32-byte-random-secret
DELIVERY_CURSOR_SECRET=replace-with-a-separate-32-byte-random-secret
# DELIVERY_CURSOR_PREVIOUS_SECRET=previous-secret-during-a-15-minute-rotation-overlap
DELIVERY_API_ENABLED=false
# Keep the complete management oRPC reference local/operator-only; never expose it as public product documentation.
MANAGEMENT_API_REFERENCE_ENABLED=false
TRUST_PROXY_HOPS=0
