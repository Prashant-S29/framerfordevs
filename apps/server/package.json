{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@framerfordevs/api": "workspace:*",
    "@framerfordevs/auth": "workspace:*",
    "@framerfordevs/db": "workspace:*",
    "@framerfordevs/env": "workspace:*",
    "@framerfordevs/public-contracts": "workspace:*",
    "@framerfordevs/schema": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@scalar/express-api-reference": "^0.10.13",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.2",
    "effect": "3.22.0",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.5",
    "typescript": "catalog:",
    "vitest": "^3.2.7"
  }
}
