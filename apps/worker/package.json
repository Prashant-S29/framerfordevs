{
  "name": "worker",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "load:attempts": "bash load/run-attempt-load.sh",
    "load:contention": "bash load/run-contention.sh",
    "load:crash-race": "bash load/run-crash-race.sh",
    "load:database-restart": "bash load/run-database-restart.sh",
    "load:key-continuity": "bash load/run-key-continuity.sh",
    "start": "node dist/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@framerfordevs/api": "workspace:*",
    "@framerfordevs/env": "workspace:*",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "3.2.7",
    "tsdown": "^0.22.3",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "3.2.7"
  }
}
