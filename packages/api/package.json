{
  "name": "@framerfordevs/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "delivery:backfill": "tsx src/scripts/delivery/backfill.ts",
    "delivery:load-prepare": "tsx src/scripts/delivery/load/prepare.ts",
    "delivery:load-boundary": "tsx src/scripts/delivery/load/boundary.ts",
    "preview:load-prepare": "tsx src/scripts/preview/load/prepare.ts",
    "preview:load-fixture": "tsx src/scripts/preview/load/fixture.ts",
    "preview:load-save-loop": "tsx src/scripts/preview/load/save-loop.ts",
    "webhook:dispatch-backlog": "tsx src/scripts/webhook/dispatch/backlog.ts",
    "webhook:load-dispatch": "tsx src/scripts/webhook/dispatch/load.ts",
    "webhook:load-attempts": "tsx src/scripts/webhook/attempt-load.ts",
    "webhook:load-contention": "tsx src/scripts/webhook/contention-load.ts",
    "webhook:key-continuity": "tsx src/scripts/webhook/key-continuity.ts",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@effect/opentelemetry": "0.64.0",
    "@effect/platform": "0.97.0",
    "@framerfordevs/auth": "workspace:*",
    "@framerfordevs/db": "workspace:*",
    "@framerfordevs/env": "workspace:*",
    "@framerfordevs/schema": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@redis/client": "6.2.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "effect": "3.22.0",
    "ipaddr.js": "2.5.0",
    "re2js": "^2.8.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@framerfordevs/config": "workspace:*",
    "@types/express": "catalog:",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "3.2.7"
  }
}
