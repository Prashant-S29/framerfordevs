{
  "name": "@framerfordevs/cli",
  "version": "0.0.0",
  "description": "Framer for Developers CLI and deterministic schema generator",
  "homepage": "https://github.com/Prashant-S29/framerfordevs#readme",
  "bugs": {
    "url": "https://github.com/Prashant-S29/framerfordevs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prashant-S29/framerfordevs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "ffd": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./generator": {
      "types": "./dist/generator.d.mts",
      "import": "./dist/generator.mjs"
    },
    "./schema-extractor": {
      "types": "./dist/schema-extractor.d.mts",
      "import": "./dist/schema-extractor.mjs"
    },
    "./experimental-schema-build": {
      "types": "./dist/experimental-schema-build.d.mts",
      "import": "./dist/experimental-schema-build.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && vite build --config vite.editor.config.ts",
    "check-types": "tsc --noEmit && tsc --project tsconfig.editor.json --noEmit",
    "prepack": "pnpm run build && pnpm run check-types && pnpm run test && pnpm run test:packaged",
    "test": "vitest run",
    "test:packaged": "node test/contract/packaged-static-schema-extractor.mjs && node test/contract/packaged-authoring-workflows.mjs && node test/contract/packaged-editor-workflow.mjs",
    "test:browser": "node test/accessibility/real-browser-editor.mjs",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@framerfordevs/schema": "workspace:*",
    "@framerfordevs/sdk": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@napi-rs/keyring": "1.3.0",
    "effect": "3.22.0",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@framerfordevs/config": "workspace:*",
    "@framerfordevs/content-form": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "^0.22.14",
    "vite": "^8.1.5",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
