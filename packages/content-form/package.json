{
  "name": "@framerfordevs/content-form",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./authoring-adapter": "./src/authoring-adapter/index.ts",
    "./model": "./src/model/index.ts",
    "./renderer": "./src/content-form/index.tsx",
    "./values": "./src/values/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@framerfordevs/ui": "workspace:*",
    "@portabletext/editor": "^7.12.4",
    "effect": "4.1.4",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "typescript": "catalog:",
    "vitest": "5.1.0"
  }
}
