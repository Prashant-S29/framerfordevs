{
  "name": "@framerfordevs/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema/cms": {
      "default": "./src/schema/cms/index.ts"
    },
    "./schema/control-plane": {
      "default": "./src/schema/control-plane/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
