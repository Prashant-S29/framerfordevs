    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@framerfordevs/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vitest": "5.1.0"
  }
}
