            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "data",
          "error",
          "message"
        ],
        "type": "object"
      },
      "StudioBootstrap": {
        "additionalProperties": false,
        "properties": {
          "effectiveActions": {
            "description": "an array of at most 2 item(s)",
            "items": {
              "enum": [
                "project.read",
                "project.update"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "title": "maxItems(2)",
            "type": "array"
          },
