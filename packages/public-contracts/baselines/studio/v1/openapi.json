    "securitySchemes": {
      "studioBearer": {
        "bearerFormat": "JWT",
        "description": "A five-minute Studio access token for the exact Studio v1 resource and `studio:session` scope. Cookies and browser storage are never accepted.",
        "scheme": "bearer",
        "type": "http"
      }
    }
