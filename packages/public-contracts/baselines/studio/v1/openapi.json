  "info": {
    "description": "Server-to-server bootstrap authority for an explicitly activated project Studio. Browser JavaScript never calls this API or receives its bearer token.",
    "title": "Framer for Devs Studio API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/projects/{projectId}/environments/{environmentId}/bootstrap": {
      "get": {
        "description": "Revalidates the active registration, exact token authority, current project membership, role, CMS capability, and audited grant marker. No content or management credential is returned.",
        "operationId": "getStudioBootstrap",
        "parameters": [
          {
            "example": "019fae8b-1234-7000-8000-000000000002",
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "example": "019fae8b-1234-7000-8000-000000000003",
            "in": "path",
            "name": "environmentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "effectiveActions": [
                      "project.read",
                      "project.update"
                    ],
                    "environment": {
                      "id": "019fae8b-1234-7000-8000-000000000003",
                      "key": "main",
                      "name": "main"
                    },
                    "formatVersion": 1,
                    "project": {
                      "id": "019fae8b-1234-7000-8000-000000000002",
                      "name": "Customer Site",
                      "workspaceId": "019fae8b-1234-7000-8000-000000000004"
                    },
                    "registration": {
                      "applicationOrigin": "https://application.example.test",
                      "id": "019fae8b-1234-7000-8000-000000000001",
                      "mountPath": "/studio",
                      "version": 3
                    },
                    "role": "developer",
                    "session": {
                      "expiresAt": "2026-09-21T20:00:00.000Z"
                    },
                    "user": {
                      "email": "studio@example.test",
                      "id": "studio-user",
                      "name": "Studio User"
                    }
                  },
                  "error": null,
                  "message": "Studio bootstrap loaded.",
                  "ok": true
                },
                "schema": {
                  "$ref": "#/components/schemas/StudioBootstrapResponse"
                }
              }
            },
            "description": "The bounded current-user Studio shell projection.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
