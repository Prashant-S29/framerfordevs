{
  "components": {
    "headers": {
      "CacheControl": {
        "description": "Bootstrap responses are never reusable authority.",
        "schema": {
          "const": "private, no-store, max-age=0",
          "type": "string"
        }
      },
      "ContentTypeOptions": {
        "schema": {
          "const": "nosniff",
          "type": "string"
        }
      },
      "RateLimitLimit": {
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "RateLimitRemaining": {
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "RateLimitReset": {
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "ReferrerPolicy": {
        "schema": {
          "const": "no-referrer",
          "type": "string"
        }
      },
      "RequestId": {
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "RetryAfter": {
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "WwwAuthenticate": {
        "schema": {
          "const": "Bearer realm=\"studio\", error=\"invalid_token\"",
          "type": "string"
        }
      }
    },
    "schemas": {
      "ApiErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "a string at most 64 character(s) long",
            "maxLength": 64,
            "minLength": 1,
            "title": "maxLength(64)",
            "type": "string"
          },
          "currentRevisionId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UUID"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentVersion": {
            "description": "a non-negative number",
            "minimum": 0,
            "title": "greaterThanOrEqualTo(0)",
            "type": "integer"
          },
          "expectedVersion": {
            "description": "a non-negative number",
            "minimum": 0,
            "title": "greaterThanOrEqualTo(0)",
            "type": "integer"
          },
          "message": {
            "description": "a string at most 512 character(s) long",
            "maxLength": 512,
            "minLength": 1,
            "title": "maxLength(512)",
            "type": "string"
          },
          "path": {
            "description": "a string at most 256 character(s) long",
            "maxLength": 256,
            "title": "maxLength(256)",
            "type": "string"
          },
          "scope": {
            "enum": [
              "shared",
              "localized"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "StudioApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CMS_CAPABILITY_REQUIRED",
              "STUDIO_REGISTRATION_INACTIVE",
              "STUDIO_AUTHORITY_CHANGED",
              "STUDIO_GRANT_INVALID",
              "STUDIO_RESPONSE_TOO_LARGE",
              "REQUEST_TOO_LARGE",
              "RATE_LIMITED",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "type": "string"
          },
          "details": {
            "description": "an array of at most 20 item(s)",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "maxItems(20)",
            "type": "array"
          },
          "message": {
            "description": "a string at most 512 character(s) long",
            "maxLength": 512,
            "minLength": 1,
            "title": "maxLength(512)",
            "type": "string"
          },
          "requestId": {
            "description": "a string matching the pattern ^[A-Za-z0-9._:-]+$",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "maxLength(128)",
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "type": "object"
      },
      "StudioApiFailure": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/StudioApiError"
          },
          "message": {
            "description": "a string at most 512 character(s) long",
            "maxLength": 512,
            "minLength": 1,
            "title": "maxLength(512)",
            "type": "string"
          },
          "ok": {
