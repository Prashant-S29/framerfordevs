{
  "name": "@framerfordevs/schema",
  "version": "0.0.0",
  "description": "Declarative code-first schema contracts for Framer for Developers",
  "homepage": "https://github.com/Prashant-S29/framerfordevs#readme",
  "bugs": {
    "url": "https://github.com/Prashant-S29/framerfordevs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prashant-S29/framerfordevs.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./compose": {
      "types": "./dist/compose.d.mts",
      "import": "./dist/compose.mjs"
    },
    "./validate": {
      "types": "./dist/validate.d.mts",
      "import": "./dist/validate.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "prepack": "pnpm run build && pnpm run check-types && pnpm run test",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@framerfordevs/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "3.2.7",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
