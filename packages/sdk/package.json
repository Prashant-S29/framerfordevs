{
  "name": "@framerfordevs/sdk",
  "version": "0.0.0",
  "description": "Framework-independent Framer for Developers Delivery, Preview, Authoring, and webhook SDK",
  "homepage": "https://github.com/Prashant-S29/framerfordevs#readme",
  "bugs": {
    "url": "https://github.com/Prashant-S29/framerfordevs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prashant-S29/framerfordevs.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d",
      "import": "./dist/client.mjs"
    },
    "./effect": {
      "types": "./dist/effect.d",
      "import": "./dist/effect.mjs"
    },
    "./authoring": {
      "types": "./dist/authoring.d",
      "import": "./dist/authoring.mjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d",
      "import": "./dist/webhooks.mjs"
    },
    "./invalidation": {
      "types": "./dist/invalidation.d",
      "import": "./dist/invalidation.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "prepack": "pnpm run build && pnpm run check-types && pnpm run test",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@framerfordevs/schema": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@framerfordevs/config": "workspace:*",
    "@framerfordevs/content-form": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "3.2.7",
    "effect": "^3.22.0",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "effect": "^3.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
