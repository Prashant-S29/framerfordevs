{
  "name": "@framerfordevs/studio-adapter-express",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "prepack": "pnpm run build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@framerfordevs/studio-server": "workspace:*"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  }
}
