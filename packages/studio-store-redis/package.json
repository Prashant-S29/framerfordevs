{
  "name": "@framerfordevs/studio-store-redis",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "prepack": "pnpm run build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@framerfordevs/studio-server": "workspace:*",
    "@redis/client": "6.2.0",
    "effect": "3.22.0"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^3.2.7",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^3.2.7"
  }
}
