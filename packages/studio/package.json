{
  "name": "@framerfordevs/studio",
  "version": "0.0.0",
  "private": true,
  "files": [
    "artifact",
    "dist",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "sideEffects": [
    "./src/app/styles.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./artifact/manifest.json": "./artifact/manifest.json",
    "./artifact/*": "./artifact/*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./contracts": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./artifact/manifest.json": "./artifact/manifest.json",
      "./artifact/*": "./artifact/*"
    }
  },
  "scripts": {
    "build": "vite build && tsdown src/index.ts --format esm --dts --clean",
    "prepack": "pnpm run build",
    "check-types": "tsc --noEmit",
    "test": "vitest run && pnpm test:bundle",
    "test:unit": "vitest run src",
    "test:accessibility": "vitest run test/accessibility",
    "test:coverage": "vitest run --coverage",
    "test:bundle": "tsx scripts/check-bundle.ts"
  },
  "devDependencies": {
    "@framerfordevs/config": "workspace:*",
    "@framerfordevs/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.22.14",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vite": "^8.1.3",
    "vitest": "^3.2.7"
  }
}
