{
  "name": "@framerfordevs/webhook-test-receiver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run check-types && pnpm run test",
    "check-types": "tsc --noEmit",
    "check:tunnel": "tsx scripts/check-tunnel.ts",
    "dev": "tsx watch src/server.ts",
    "report": "tsx scripts/report.ts",
    "smoke:tunnel": "tsx scripts/send-smoke.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts test/**/*.test.ts",
    "test:unit": "tsx --test src/**/*.test.ts",
    "test:contract": "tsx --test test/contract/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage src/**/*.test.ts test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.1",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
